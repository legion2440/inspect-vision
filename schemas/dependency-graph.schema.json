{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspect-vision.local/schemas/dependency-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "allowed_edges", "forbidden_edges", "acyclic_edge_types"],
  "properties": {
    "schema_version": { "const": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "allowed_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/allowed" }
    },
    "forbidden_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/forbidden" }
    },
    "acyclic_edge_types": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "allowed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "rationale"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "enum": ["runtime", "contract", "verification", "build", "configuration", "artifact"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
