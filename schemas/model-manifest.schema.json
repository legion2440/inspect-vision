{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspect-vision.local/schemas/model-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultModelId", "preprocessingProfiles", "models"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "defaultModelId": { "type": "string", "minLength": 1 },
    "defaultRationale": { "type": "string", "minLength": 1 },
    "preprocessingProfiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/preprocessingProfile" },
      "required": ["standard-color", "steel-enhanced"]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rgb": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "preprocessingProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "paddingColor"],
          "properties": {
            "mode": { "const": "standard-color" },
            "paddingColor": { "$ref": "#/$defs/rgb" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "paddingColor", "clahe"],
          "properties": {
            "mode": { "const": "steel-enhanced" },
            "paddingColor": { "$ref": "#/$defs/rgb" },
            "clahe": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clipLimit", "tileGridSize"],
              "properties": {
                "clipLimit": { "type": "number", "exclusiveMinimum": 0 },
                "tileGridSize": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "integer", "minimum": 1 },
                    { "type": "integer", "minimum": 1 }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUrl",
        "downloadUrl",
        "revision",
        "sourceFilename",
        "license",
        "licenseSourceUrl"
      ],
      "properties": {
        "repositoryUrl": { "type": "string", "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceFilename": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "licenseSourceUrl": { "type": "string", "format": "uri" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "role",
        "domain",
        "description",
        "filename",
        "sha256",
        "sizeBytes",
        "task",
        "framework",
        "inputSize",
        "nativeClasses",
        "confidence",
        "iou",
        "preprocessingProfile",
        "quality",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "role": { "enum": ["general", "specialist"] },
        "domain": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "pattern": "^[^/\\\\]+\\.pt$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "task": { "const": "detect" },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["library", "modelFamily", "testedVersion"],
          "properties": {
            "library": { "const": "ultralytics" },
            "modelFamily": { "type": "string", "minLength": 1 },
            "testedVersion": { "type": "string", "minLength": 1 }
          }
        },
        "inputSize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "nativeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "iou": { "type": "number", "minimum": 0, "maximum": 1 },
        "preprocessingProfile": { "type": "string", "minLength": 1 },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultWeight", "classWeights"],
          "properties": {
            "defaultWeight": { "type": "number", "exclusiveMinimum": 0 },
            "classWeights": {
              "type": "object",
              "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
