{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspect-vision.local/schemas/model-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultModelId", "preprocessingProfiles", "models"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "defaultModelId": { "type": "string", "minLength": 1 },
    "defaultRationale": { "type": "string", "minLength": 1 },
    "preprocessingProfiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/preprocessingProfile" },
      "required": ["standard-color", "steel-enhanced"]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rgb": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "triplet": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "preprocessingProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "paddingColor"],
          "properties": {
            "mode": { "const": "standard-color" },
            "paddingColor": { "$ref": "#/$defs/rgb" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "paddingColor", "clahe"],
          "properties": {
            "mode": { "const": "steel-enhanced" },
            "paddingColor": { "$ref": "#/$defs/rgb" },
            "clahe": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clipLimit", "tileGridSize"],
              "properties": {
                "clipLimit": { "type": "number", "exclusiveMinimum": 0 },
                "tileGridSize": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "integer", "minimum": 1 },
                    { "type": "integer", "minimum": 1 }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      ]
    },
    "artifactSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUrl",
        "downloadUrl",
        "revision",
        "sourceFilename",
        "license",
        "licenseSourceUrl",
        "licenseScope"
      ],
      "properties": {
        "repositoryUrl": { "type": "string", "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "sourceFilename": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "licenseSourceUrl": { "type": "string", "format": "uri" },
        "licenseScope": { "enum": ["checkpoint", "repository", "repository-code-only"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "sha256", "sizeBytes", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "filename": { "type": "string", "pattern": "^[^/\\\\]+\\.(?:pt|pth)$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/artifactSource" }
      }
    },
    "inputSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultWeight", "classWeights"],
      "properties": {
        "defaultWeight": { "type": "number", "exclusiveMinimum": 0 },
        "classWeights": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "ultralyticsConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "framework", "confidence", "iou", "preprocessingProfile"],
      "properties": {
        "task": { "const": "detect" },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["library", "modelFamily", "testedVersion"],
          "properties": {
            "library": { "const": "ultralytics" },
            "modelFamily": { "type": "string", "minLength": 1 },
            "testedVersion": { "type": "string", "minLength": 1 }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "iou": { "type": "number", "minimum": 0, "maximum": 1 },
        "preprocessingProfile": { "type": "string", "minLength": 1 }
      }
    },
    "anomalyclipConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "sourceCommit",
        "preprocessing",
        "featuresList",
        "featureMapLayers",
        "dpamLayer",
        "prompt",
        "gaussianSigma",
        "postprocessing",
        "scoreCalibration"
      ],
      "properties": {
        "task": { "const": "anomaly-localization" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "preprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "resize", "normalization"],
          "properties": {
            "profileId": { "const": "anomalyclip-stretch" },
            "resize": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "width", "height", "interpolation"],
              "properties": {
                "mode": { "const": "stretch" },
                "width": { "const": 518 },
                "height": { "const": 518 },
                "interpolation": { "const": "bicubic" }
              }
            },
            "normalization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mean", "std"],
              "properties": {
                "mean": { "$ref": "#/$defs/triplet" },
                "std": { "$ref": "#/$defs/triplet" }
              }
            }
          }
        },
        "featuresList": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "featureMapLayers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "dpamLayer": { "type": "integer", "minimum": 0 },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "className",
            "promptLength",
            "learnableTextEmbeddingDepth",
            "learnableTextEmbeddingLength"
          ],
          "properties": {
            "className": { "const": "object" },
            "promptLength": { "type": "integer", "minimum": 1 },
            "learnableTextEmbeddingDepth": { "type": "integer", "minimum": 1 },
            "learnableTextEmbeddingLength": { "type": "integer", "minimum": 1 }
          }
        },
        "gaussianSigma": { "type": "number", "minimum": 0 },
        "postprocessing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mapThreshold", "morphology", "minComponentAreaRatio", "mergeDistancePx"],
          "properties": {
            "mapThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "morphology": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kernel", "kernelSize", "openIterations", "closeIterations"],
              "properties": {
                "kernel": { "enum": ["ellipse", "rectangle", "none"] },
                "kernelSize": { "type": "integer", "minimum": 1 },
                "openIterations": { "type": "integer", "minimum": 0 },
                "closeIterations": { "type": "integer", "minimum": 0 }
              }
            },
            "minComponentAreaRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "mergeDistancePx": { "type": "integer", "minimum": 0 }
          }
        },
        "scoreCalibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "sizeBytes", "semanticMeaning"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^backend/models/config/[A-Za-z0-9._-]+\\.json$"
            },
            "sha256": { "$ref": "#/$defs/sha256" },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "semanticMeaning": {
              "const": "anomaly confidence score relative to clean calibration artifacts; not a class probability"
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "role",
        "domain",
        "description",
        "backend",
        "exposed",
        "artifacts",
        "inputSize",
        "nativeClasses",
        "quality",
        "backendConfig"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "role": { "enum": ["general", "specialist"] },
        "domain": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "backend": { "enum": ["ultralytics", "anomalyclip"] },
        "exposed": { "type": "boolean" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "inputSize": { "$ref": "#/$defs/inputSize" },
        "nativeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "quality": { "$ref": "#/$defs/quality" },
        "backendConfig": {}
      },
      "allOf": [
        {
          "if": { "properties": { "backend": { "const": "ultralytics" } } },
          "then": { "properties": { "backendConfig": { "$ref": "#/$defs/ultralyticsConfig" } } }
        },
        {
          "if": { "properties": { "backend": { "const": "anomalyclip" } } },
          "then": { "properties": { "backendConfig": { "$ref": "#/$defs/anomalyclipConfig" } } }
        }
      ]
    }
  }
}
