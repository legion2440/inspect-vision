{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspect-vision.local/schemas/model-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selectedModelId", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "selectedModelId": { "type": "string", "minLength": 1 },
    "selectionRationale": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUrl",
        "downloadUrl",
        "revision",
        "sourceFilename",
        "license",
        "licenseSourceUrl"
      ],
      "properties": {
        "repositoryUrl": { "type": "string", "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceFilename": { "type": "string", "minLength": 1 },
        "license": { "const": "MIT" },
        "licenseSourceUrl": { "type": "string", "format": "uri" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "sha256",
        "sizeBytes",
        "task",
        "framework",
        "inputSize",
        "classes",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "filename": { "type": "string", "pattern": "^[^/\\\\]+\\.pt$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "task": { "const": "detect" },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["library", "modelFamily", "testedVersion"],
          "properties": {
            "library": { "const": "ultralytics" },
            "modelFamily": { "const": "YOLOv8" },
            "testedVersion": { "type": "string", "minLength": 1 }
          }
        },
        "inputSize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
