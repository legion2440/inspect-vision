# FastAPI runtime
INSPECT_VISION_HOST=127.0.0.1
INSPECT_VISION_PORT=8000
INSPECT_VISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INSPECT_VISION_MAX_UPLOAD_BYTES=10485760

# Detection registry. Per-model inference, preprocessing, and scoring settings
# are tracked in backend/models/model-manifest.json.
INSPECT_VISION_MODELS_DIR=backend/models
# auto selects CUDA first, then Apple MPS, then CPU.
# Explicit values: auto | cpu | cuda | cuda:N | mps
INSPECT_VISION_MODEL_DEVICE=auto

# Persistent metadata and image artifacts
INSPECT_VISION_DATABASE_PATH=backend/storage/inspections.sqlite3
INSPECT_VISION_MEDIA_DIR=backend/storage/media
