# Keep empty in development so browser requests use Vite's /api proxy.
# Set an absolute URL only when the production frontend and API use different origins.
VITE_API_BASE_URL=

# false -> all calls go to the real /api backend (default integration mode)
# true  -> UI runs on bundled mock responses (explicit standalone mode)
VITE_USE_MOCK=false

# Max upload size in bytes (10 MB) and accepted mime types
VITE_MAX_UPLOAD_BYTES=10485760
VITE_ACCEPTED_TYPES=image/jpeg,image/png
