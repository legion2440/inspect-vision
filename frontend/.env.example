# Base URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# false -> all calls go to VITE_API_BASE_URL (default integration mode)
# true  -> UI runs on bundled mock responses (explicit standalone mode)
VITE_USE_MOCK=false

# Max upload size in bytes (10 MB) and accepted mime types
VITE_MAX_UPLOAD_BYTES=10485760
VITE_ACCEPTED_TYPES=image/jpeg,image/png
